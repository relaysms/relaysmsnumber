# RelayNumber remains preview-only. The server-only GrizzlySMS client powers a
# read-only catalog when configured; ordering, rentals, and callbacks stay off.
# Configure values in the local .env.local file for development and in the
# deployment host's encrypted environment-variable settings for production.
# Do not put server secrets in any NEXT_PUBLIC_* variable.

# Runtime/site
# APP_ENV: non-secret label (development / staging / production); host config.
APP_ENV=development
# Public canonical HTTPS URL; set in hosting project environment settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication and persistence — choose a supported provider first.
# AUTH_PROVIDER: non-secret adapter name (provider docs/configuration).
AUTH_PROVIDER=
# AUTH_SECRET: SECRET, generated in auth-provider/server configuration; never expose to browser.
AUTH_SECRET=
# DATABASE_URL: SECRET connection string from selected database provider; server-only.
DATABASE_URL=

# Virtual number and SMS provider — GrizzlySMS (https://grizzlysms.com/docs).
# Configure these in local .env.local for development and encrypted Vercel
# Preview/Production environment settings for deployment. Values alone do not
# enable customer ordering or webhooks; those routes remain unavailable.
# NUMBER_PROVIDER: non-secret adapter name; currently grizzlysms.
NUMBER_PROVIDER=grizzlysms
# GRIZZLY_ALLOWED_COUNTRIES: optional server-side comma-separated GrizzlySMS
# numeric country IDs for an emergency restriction. Leave blank to show every
# country returned by GrizzlySMS. Never use a browser-exposed variable.
GRIZZLY_ALLOWED_COUNTRIES=
# GRIZZLY_SMS_API_KEY: SECRET API key from the GrizzlySMS account API settings.
# Set in local .env.local or Vercel's sensitive Preview environment variable.
# GrizzlySMS requires api_key as a query parameter; the server never logs URLs.
GRIZZLY_SMS_API_KEY=

# Payments — choose a processor eligible for the legal business country and recurring billing.
# PAYMENT_PROVIDER: non-secret adapter name from payment integration setup.
PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY: SECRET server API key from the payment processor dashboard.
PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET: SECRET signing secret for payment webhook verification.
PAYMENT_WEBHOOK_SECRET=

# Support delivery — select a support provider/mail service and approved destination.
# SUPPORT_PROVIDER: non-secret adapter name.
SUPPORT_PROVIDER=
# SUPPORT_PROVIDER_API_KEY: SECRET key from the selected provider console.
SUPPORT_PROVIDER_API_KEY=

# Public policy URLs/content references; owner/counsel-approved and hosted on the website.
# These are not secrets. Replace only after the policies have been finalized.
REFUND_POLICY_URL=
CANCELLATION_POLICY_URL=
PRIVACY_POLICY_URL=
TERMS_POLICY_URL=
